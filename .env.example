# Postgres connection string. Local dev: matches docker-compose.yml.
# Production: a single env var, so moving to AWS RDS later is a one-line change.
DATABASE_URI=postgres://wsoftblog:wsoftblog@localhost:5432/wsoftblog

# Used to sign Payload's auth cookies/JWTs. Generate a real value for every
# environment — never reuse this placeholder.
PAYLOAD_SECRET=changeme-generate-a-real-secret

# Public URL of this app (used for admin links, media URLs in emails, etc).
# CRITICAL: this must be the browser-facing origin EXACTLY — scheme, host
# spelling (localhost vs 127.0.0.1) and port — because Payload derives its
# CSRF origin allowlist from it. If it doesn't match the URL the admin is
# actually opened at, every admin save/publish fails with 403.
# VM deploy / local dev / Playwright only — do NOT set this on Vercel, in any
# environment. It's build-inlined and goes stale the moment the project's
# hostname changes, with nothing to re-inline it (WOS-339: a stale value
# broke every blog image in prod). src/lib/deployOrigins.ts and
# src/lib/siteUrl.ts derive the origin from Vercel's own runtime vars there.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where uploaded media is written. VM deploy only — this MUST live outside
# the deploy directory (APP_PATH), or uploads get wiped by every redeploy.
# Ignored entirely once S3_BUCKET is set (Vercel/Supabase deploy, WOS-324):
# the s3Storage plugin disables local storage for the media collection.
MEDIA_DIR=media

NODE_ENV=development

# --- Seed script only (optional overrides, see src/seed/index.ts) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=

# --- E2E only ---
# E2E_BASE_URL=

# --- Vercel + Supabase deploy only (WOS-324) ---
# Setting S3_BUCKET enables @payloadcms/storage-s3 in src/payload.config.ts.
# Values come from Supabase Dashboard -> Storage -> Settings -> S3 Connection
# (endpoint + region) and S3 Access Keys (credentials). See README.md for the
# full runbook.
# S3_BUCKET=media
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Session-mode Supabase pooler string (port 5432), used only for the
# `migrate` step at Vercel build time. Runtime DATABASE_URI should be the
# transaction-mode pooler (port 6543) — see README.md.
# DATABASE_URI_SESSION=

# Kill-switch preventing a dev-mode local shell from pushing schema when
# pointed at a remote database (e.g. to seed Supabase). See README.md.
# PAYLOAD_DISABLE_PUSH=true

# --- Email: company Gmail SMTP (optional) ---
# WOS-338: these are the *W Labs company* Gmail account's credentials, not a
# personal account's. One set of credentials serves two senders:
#   1. the contact route (src/app/api/contact/route.ts) -> CONTACT_RECIPIENT_EMAIL
#   2. Payload's own admin mail — forgot-password / email verification — via
#      the @payloadcms/email-nodemailer adapter in src/payload.config.ts
# All three unset by default in every environment (local dev, CI, e2e). The
# contact route then returns mail:"skipped" and Payload falls back to its
# built-in console adapter with a startup warning; neither ever fails a build
# or a request. Set all three together, or none.
#
# GMAIL_APP_PASSWORD is a 16-character Google App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), NOT the account login
# password; 2FA must be on for the company account. Literal spaces are fine.
# GMAIL_USER doubles as the From address for both senders — Gmail rejects or
# rewrites a From that isn't the authenticating account.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CONTACT_RECIPIENT_EMAIL=

# --- Contact form reCAPTCHA v3 (WOS-334, optional) ---
# Both unset by default in every environment (local dev, CI, e2e) — the
# contact route handler then records captchaStatus:"skipped" and accepts
# the submission anyway; it never fails a build or a request. Set both
# together (from the reCAPTCHA admin console) to actually verify tokens
# server-side. NEXT_PUBLIC_RECAPTCHA_SITE_KEY is build-inlined like
# NEXT_PUBLIC_SERVER_URL above — see that var's own comment.
# RECAPTCHA_SECRET=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
